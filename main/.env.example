# 이 파일을 .env.local로 복사하고 값을 넣어요. (.env.local은 git에 올라가지 않아요)
# Supabase 대시보드 > Project Settings > API 에서 확인해요.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# publishable 키(sb_publishable_...) 또는 anon 키. service_role/secret 키는 절대 넣지 마세요.
VITE_SUPABASE_KEY=
# 브이월드 검색 API 키(전국 장소·지역 검색). 브라우저에서 불러서 페이지에 보여요. 해외 서버는 브이월드가 막아요.
VITE_VWORLD_KEY=
